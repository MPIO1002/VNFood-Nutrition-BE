{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calcucalo.local/schemas/evaluation_sample.schema.json",
  "title": "One line in a CalcuCalo weighed evaluation JSONL manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "foods"],
  "properties": {
    "image": {"type": "string", "minLength": 1},
    "container_type": {
      "type": "string",
      "enum": ["chen", "to", "to_lon", "dia_nho", "dia", "dia_lon", "hop"]
    },
    "foods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["food_id"],
        "properties": {
          "food_id": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
          "weight_g": {"type": "number", "minimum": 0},
          "calories_kcal": {"type": "number", "minimum": 0},
          "protein_g": {"type": "number", "minimum": 0},
          "fat_g": {"type": "number", "minimum": 0},
          "carb_g": {"type": "number", "minimum": 0}
        }
      }
    }
  }
}
