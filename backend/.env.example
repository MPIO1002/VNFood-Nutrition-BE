# Neon PostgreSQL. Keep the real credentials in .env; never commit them.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DB_POOL_MIN=1
DB_POOL_MAX=5

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_ISSUER=calcucalo-api
JWT_AUDIENCE=calcucalo-mobile
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30

# Vision configuration
# CALCUCALO_MODEL=models/best.pt
CALCUCALO_SEGMENTER=grabcut

# Cloudinary – image upload service (required for POST /api/v1/upload/image)
# Create a free account at https://cloudinary.com then copy from the dashboard.
CLOUDINARY_CLOUD_NAME=sbs07juo
CLOUDINARY_API_KEY=228672832519556
CLOUDINARY_API_SECRET=LXluRU5ft83qZ9ggL2Ms9JRdyJc
# Optional: upload folder prefix (default: calcucalo)
# CLOUDINARY_FOLDER=calcucalo
